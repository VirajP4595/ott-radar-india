{
  "name": "ott-radar-india",
  "version": "1.0.0",
  "private": true,
  "description": "Installable web app tracking new OTT releases in India, by day, week and month.",
  "type": "module",
  "scripts": {
    "db:local": "wrangler d1 execute ott-radar-india --local --file schema.sql",
    "db:remote": "wrangler d1 execute ott-radar-india --remote --file schema.sql",
    "dev": "wrangler pages dev public --port 8788 --binding ADMIN_TOKEN=dev-admin-token",
    "deploy": "wrangler pages deploy public --project-name ott-radar-india",
    "test": "node tests/e2e.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "playwright": "^1.49.0"
  }
}
